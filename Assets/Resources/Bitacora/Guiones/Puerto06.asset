  m_Script: {fileID: 11500000, guid: f3420aacd20efec408a1f736c7bfa607, type: 3}
  m_Name: Puerto06
  m_EditorClassIdentifier: Assembly-CSharp::LevelDefinition
  indice: 6
  nombre: Nivel 6 - Esclusa de las Dos Llaves
  tituloIntro: Esclusa de las Dos Llaves
  textoIntro: "La esclusa tiene dos llaves de presi\xF3n. Los estibadores se llevaron
    todas las cajas menos una. Maia est\xE1 contenta: dice que aqu\xED, la noche
    de la crecida, Nilo fue un h\xE9roe."
  pistaMaia: "Empieza por el panel del oeste. Cuando la palanca abra el paso sur,
    recupera la misma caja para los barrotes. En la sala de m\xE1quinas hay otro
    camino de vuelta."
  textoCierre: "Las dos hojas de la esclusa se abren a la vez. \xAB\xBFLo ves? Siempre
    fuiste bueno en esto\xBB, dice Maia. Nilo no recuerda haberlo hecho nunca."
  recuerdoIdentificador: nivel6_recuerdo
  recuerdoTitulo: "Recuerdo 6 \xB7 El h\xE9roe de la esclusa"
  recuerdoTexto: "Aquella noche Nilo abri\xF3 las dos hojas de la esclusa y todas
    las barcas salieron antes de la crecida. Nadie se qued\xF3 atr\xE1s. Liria entera
    le dio las gracias. (El recuerdo es n\xEDtido, c\xE1lido y perfecto. Demasiado
    perfecto.)"
  reservaCasillas: 22
  tutorialPatio: 0
  tutorialCondensadores: 0
  salidaEsFaro: 0
