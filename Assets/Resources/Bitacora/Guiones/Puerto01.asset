  m_Script: {fileID: 11500000, guid: f3420aacd20efec408a1f736c7bfa607, type: 3}
  m_Name: Puerto01
  m_EditorClassIdentifier: Assembly-CSharp::LevelDefinition
  indice: 1
  nombre: Nivel 1 - Muelle de Cobre
  tituloIntro: Muelle de Cobre
  textoIntro: "\xABBuenas noches a quienes siguen de turno\xBB. La voz sale de una
    radio junto al muelle. Se llama Maia y dice que llevaba mucho tiempo esperando
    a alguien. Liria est\xE1 a oscuras y los puentes siguen bajo el agua. Junto a
    Nilo queda una bater\xEDa: encaja en su pecho como si siempre hubiera sido suya."
  pistaMaia: "La bater\xEDa abre el paso, pero la palanca abre el regreso. En el
    muelle hay dos orillas que cruzar: haz lo mismo dos veces."
  textoCierre: Las tres orillas del Muelle vuelven a estar conectadas. Maia le da
    las gracias a Nilo como si hubiera vuelto de un viaje muy largo.
  recuerdoIdentificador: nivel1_recuerdo
  recuerdoTitulo: "Recuerdo 1 \xB7 La primera canci\xF3n"
  recuerdoTexto: "Entre el zumbido de las subestaciones, una noche, algo cant\xF3.
    No era una alarma ni una aver\xEDa. Era una voz que dec\xEDa: \xABBuenas noches
    a quienes siguen de turno\xBB. Nilo dej\xF3 de contar voltios para escucharla."
  reservaCasillas: 0
  tutorialPatio: 0
  tutorialCondensadores: 0
  salidaEsFaro: 0
