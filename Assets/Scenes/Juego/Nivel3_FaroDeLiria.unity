  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9248529215d703943bca5ee394fbe81d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MaiaTerminal
  TextoIntroduccion: "El faro necesita la \xFAltima bater\xEDa. Aqu\xED los puentes
    tienen condensadores: guardan un poco de energ\xEDa cuando la bater\xEDa se va."
  TextoPista: "Carga el condensador del todo antes de retirar la bater\xEDa. La caja
    del pasillo va al norte, no al fondo. La palanca est\xE1 demasiado lejos de D:
    ll\xE9vale la bater\xEDa en la mano."
  TextoFinal: "El faro vuelve a se\xF1alar la ruta segura. Los primeros botes cruzan
    el canal."
  ancla: {fileID: 1759773412}
