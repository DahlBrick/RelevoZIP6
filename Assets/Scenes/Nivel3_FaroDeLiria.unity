  m_Script: {fileID: 11500000, guid: 9248529215d703943bca5ee394fbe81d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MaiaTerminal
  TextoIntroduccion: "El faro necesita la \xFAltima bater\xEDa. Ll\xE9vala hasta
    su base y entr\xE9gala."
  TextoPista: "Ya conoces las dos clases de camino. Usa la energ\xEDa solo donde
    haga falta."
  TextoFinal: "El faro vuelve a se\xF1alar la ruta segura. Los primeros botes cruzan
    el canal."
  ancla: {fileID: 1537337818}
